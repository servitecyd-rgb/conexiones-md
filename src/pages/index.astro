---
import opiniones from '../data/opiniones.json';
const totalOpiniones = opiniones.length;
const promedio = totalOpiniones ? (opiniones.reduce((a, o) => a + o.estrellas, 0) / totalOpiniones).toFixed(1).replace('.', ',') : '';
const estrellasTxt = (n) => '★'.repeat(n) + '☆'.repeat(5 - n);
const phone = '584120565259';
const wa = (message = 'Hola, vengo de la página web de Conexiones MD. Quiero consultar por una reparación.') => `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
const services = [
  ['▣', 'Cambio de pantallas', 'Reemplazo de pantallas dañadas o con fallas de imagen y táctil.'],
  ['◉', 'Cambio de baterías', 'Recupera la autonomía de tu teléfono con una batería de calidad.'],
  ['ϟ', 'Centros de carga', 'Soluciones para problemas de carga y conexión USB.'],
  ['⌁', 'Placas electrónicas', 'Diagnóstico y reparación de fallas electrónicas.'],
  ['⌘', 'Software', 'Atención a fallas del sistema y problemas de funcionamiento.'],
  ['▤', 'Liberación y desbloqueo', 'Consulta opciones de liberación y desbloqueo para tu equipo.'],
  ['◎', 'Reparación de cámaras', 'Revisión de cámaras con fallas, daños o problemas de enfoque.'],
  ['✳', 'Mantenimiento y limpieza', 'Limpieza y mantenimiento preventivo de tu dispositivo.'],
  ['◈', 'Accesorios', 'Encuentra accesorios para complementar y proteger tu celular.'],
  ['◇', 'Repuestos', 'Repuestos de buena calidad para diferentes necesidades.'],
  ['＋', 'Otros servicios', '¿Tu falla es diferente? Escríbenos y cuéntanos qué le sucede.'],
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101010" />
    <meta name="description" content="Conexiones MD: servicio técnico de iPhone y Android en Urachiche, Yaracuy. Reparaciones con garantía y repuestos de buena calidad. Solicita atención por WhatsApp." />
    <title>Conexiones MD | Servicio técnico de celulares en Urachiche</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#inicio" aria-label="Conexiones MD, inicio"><span class="brand-mark">C<span>M</span></span><span>CONEXIONES <b>MD</b><small>SERVICIO TÉCNICO</small></span></a>
      <nav aria-label="Navegación principal">
        <a href="#servicios">Servicios</a><a href="#trabajos">Trabajos</a><a href="#consulta">Consulta online</a><a href="#nosotros">Por qué elegirnos</a><a href="#opiniones">Opiniones</a><a href="#contacto">Contacto</a>
      </nav>
      <a class="header-cta" href={wa('Hola, Conexiones MD. Quiero solicitar una revisión para mi celular.')} target="_blank" rel="noopener noreferrer"> <span>Escríbenos</span> <b>↗</b></a>
    </header>

    <main>
      <section class="hero" id="inicio">
        <div class="hero-grid"></div>
        <div class="hero-copy">
          <div class="eyebrow"><i></i> URACHICHE · YARACUY · VENEZUELA</div>
          <h1>Taller especializado<br /><em>en reparación móvil.</em></h1>
          <p class="hero-lead">Diagnóstico técnico y reparación de celulares iPhone y Android. Trabajamos con placas electrónicas, microsoldadura, centros de carga, pantallas y fallas de software.</p>
          <div class="hero-actions"><a class="button button-primary" href={wa()} target="_blank" rel="noopener noreferrer">Solicitar reparación <span>↗</span></a><a class="text-link" href="#servicios">Explorar servicios <span>↓</span></a></div>
          <div class="hero-proof"><span class="proof-icon">✓</span><span><b>Tu equipo, nuestra prioridad</b><small>Atención cercana y orientación directa.</small></span></div>
        </div>
        <div class="hero-art hero-workshop" aria-label="Fotografía real de una placa electrónica en reparación">
          <div class="workshop-photo"><img src="/trabajos/placa-electronica-general.jpg" alt="Placa electrónica de celular en proceso de diagnóstico en Conexiones MD" /></div>
          <div class="workshop-label workshop-label-top"><span class="pulse-dot"></span> TALLER DE ELECTRÓNICA MÓVIL</div>
          <div class="workshop-label workshop-label-bottom"><b>MICROSOLDADURA</b><span>DIAGNÓSTICO · REPARACIÓN · PRUEBAS</span></div>
          <div class="workshop-mini"><img src="/trabajos/microsoldadura-chip.jpg" alt="Detalle de microcomponente de placa" /><span><b>Trabajo de precisión</b><small>Placas y componentes</small></span></div>
        </div>
        <div class="hero-bottom"><span>01 / SERVICIO TÉCNICO</span><span>CALIDAD · CONFIANZA · GARANTÍA</span></div>
      </section>

      <section class="ticker" aria-label="Especialidades"><div>IPHONE <i>✳</i> ANDROID <i>✳</i> PANTALLAS <i>✳</i> BATERÍAS <i>✳</i> SOFTWARE <i>✳</i> REPUESTOS <i>✳</i> </div></section>

      <section class="section services-section" id="servicios">
        <div class="section-heading"><div><div class="eyebrow dark-eyebrow"><i></i> LO QUE HACEMOS</div><h2>Soluciones para<br /><em>seguir conectado.</em></h2></div><p>Desde una pantalla rota hasta una falla electrónica: cuéntanos qué le pasa a tu equipo y te orientamos sobre el servicio que necesita.</p></div>
        <div class="services-grid">{services.map(([icon, title, desc], i) => <article class="service-card"><div class="service-top"><span class="service-icon">{icon}</span><span class="service-number">{String(i + 1).padStart(2, '0')}</span></div><h3>{title}</h3><p>{desc}</p><a href={wa(`Hola, Conexiones MD. Quisiera consultar por el servicio de ${title.toLowerCase()}.`)} target="_blank" rel="noopener noreferrer" aria-label={`Consultar por ${title}`}>Consultar <span>↗</span></a></article>)}</div>
      </section>

      <section class="gallery-section" id="trabajos">
        <div class="section-heading"><div><div class="eyebrow"><i></i> TRABAJO REAL DE TALLER</div><h2>Precisión en cada<br /><em>reparación.</em></h2></div><p>Fotografías reales del taller: diagnóstico de placas, microsoldadura, revisión de conectores y pruebas de funcionamiento.</p></div>
        <div class="gallery-grid">
          <figure class="work-card work-card-large"><img src="/trabajos/placa-electronica-general.jpg" alt="Placa electrónica de un teléfono durante una reparación" loading="lazy" /><figcaption><b>Reparación de placas</b><span>Diagnóstico de circuitos y componentes electrónicos</span></figcaption></figure>
          <figure class="work-card"><img src="/trabajos/equipo-abierto.jpg" alt="Teléfono desarmado durante el proceso de reparación" loading="lazy" /><figcaption><b>Revisión interna</b><span>Inspección de componentes y conexiones</span></figcaption></figure>
          <figure class="work-card"><img src="/trabajos/microsoldadura-chip.jpg" alt="Microcomponente de placa observado para microsoldadura" loading="lazy" /><figcaption><b>Microsoldadura</b><span>Trabajo de precisión sobre circuitos</span></figcaption></figure>
          <figure class="work-card"><img src="/trabajos/placa-electronica-azul.jpg" alt="Placa electrónica azul en banco de trabajo" loading="lazy" /><figcaption><b>Electrónica avanzada</b><span>Revisión de pistas y componentes</span></figcaption></figure>
          <figure class="work-card"><img src="/trabajos/prueba-carga-equipo.jpg" alt="Prueba de carga de un teléfono en el taller" loading="lazy" /><figcaption><b>Pruebas de carga</b><span>Comprobación del funcionamiento del equipo</span></figcaption></figure>
          <figure class="work-card"><img src="/trabajos/microscopio-centro-carga-1.jpg" alt="Conector de carga observado bajo microscopio" loading="lazy" /><figcaption><b>Centros de carga</b><span>Inspección de conectores USB</span></figcaption></figure>
          <figure class="work-card"><img src="/trabajos/microscopio-centro-carga-2.jpg" alt="Conector de carga y soldaduras bajo microscopio" loading="lazy" /><figcaption><b>Soldadura de conectores</b><span>Detalle de contactos y terminales</span></figcaption></figure>
          <figure class="work-card"><img src="/trabajos/prueba-encendido-celular.jpg" alt="Celular encendido luego de una revisión técnica" loading="lazy" /><figcaption><b>Pruebas de funcionamiento</b><span>Verificación del equipo después del servicio</span></figcaption></figure>
          <figure class="work-card"><img src="/trabajos/microscopio-placa-detalle.jpg" alt="Detalle de una zona de placa electrónica bajo microscopio" loading="lazy" /><figcaption><b>Diagnóstico con microscopio</b><span>Inspección de pistas y componentes pequeños</span></figcaption></figure>
        </div>
      </section>

      <section class="consult-section" id="consulta">
        <div class="consult-heading"><div class="eyebrow dark-eyebrow"><i></i> DIAGNÓSTICO INICIAL</div><h2>Cuéntanos qué le pasa<br /><em>a tu celular.</em></h2><p>Completa estos datos y enviaremos tu consulta a nuestro WhatsApp para orientarte sobre la reparación.</p><div class="consult-note"><span>✓</span> La revisión definitiva y el presupuesto se confirman después de evaluar el equipo.</div></div>
        <form class="consult-form" id="repair-form">
          <div class="form-row"><label>Tu nombre<input name="nombre" autocomplete="name" placeholder="¿Cómo te llamas?" required /></label><label>Tu WhatsApp<input name="contacto" autocomplete="tel" placeholder="Tu número de contacto" required /></label></div>
          <div class="form-row"><label>Tipo de equipo<select name="equipo" required><option value="" disabled selected>Selecciona</option><option>iPhone</option><option>Android</option><option>Otro</option></select></label><label>Marca y modelo<input name="modelo" placeholder="Ej. Samsung A54, iPhone 13" required /></label></div>
          <label>¿Qué problema presenta?<select name="falla" required><option value="" disabled selected>Selecciona la falla</option><option>Pantalla rota o sin imagen</option><option>No carga / centro de carga</option><option>Batería dura poco</option><option>No enciende</option><option>Problema de software</option><option>Cámara u otro componente</option><option>Otro problema</option></select></label>
          <label>Describe un poco más (opcional)<textarea name="detalle" rows="3" placeholder="Cuéntanos cuándo comenzó la falla y qué sucede..."></textarea></label>
          <button class="button button-primary consult-submit" type="submit">Enviar consulta por WhatsApp <span>↗</span></button>
          <small class="form-privacy">Al enviar, se abrirá WhatsApp con los datos que escribiste para que puedas confirmar el mensaje.</small>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </section>

      <section class="why-section" id="nosotros"><div class="why-visual"><div class="why-ring"></div><div class="why-symbol">CM<span>✳</span></div><div class="visual-caption">TECNOLOGÍA QUE<br />VUELVE A CONECTAR</div></div><div class="why-copy"><div class="eyebrow"><i></i> CONEXIONES MD</div><h2>Reparamos con<br /><em>compromiso.</em></h2><p class="why-intro">Sabemos lo importante que es tu celular en el día a día. Por eso trabajamos para ofrecerte una atención clara y soluciones pensadas para tu equipo.</p><div class="benefit"><span>01</span><div><h3>Garantía en las reparaciones</h3><p>Ofrecemos de 1 a 3 meses de garantía, dependiendo del tipo de reparación realizada.</p></div></div><div class="benefit"><span>02</span><div><h3>Repuestos de buena calidad</h3><p>Seleccionamos repuestos de buena calidad para cuidar el funcionamiento de tu dispositivo.</p></div></div><div class="benefit"><span>03</span><div><h3>iPhone y Android</h3><p>Atendemos equipos iPhone y Android en general.</p></div></div><a class="button button-outline" href={wa('Hola, quiero conocer más sobre sus servicios y garantías.')} target="_blank" rel="noopener noreferrer">Conoce más por WhatsApp <span>↗</span></a></div></section>

      <section class="reviews-section" id="opiniones">
        <div class="section-heading reviews-heading"><div><div class="eyebrow dark-eyebrow"><i></i> EXPERIENCIAS</div><h2>La confianza se<br /><em>construye juntos.</em></h2></div><p>Lo que dicen quienes ya repararon su equipo con nosotros. Tu opinión también cuenta.</p></div>
        <div class="reviews-layout">
          <div class="reviews-list">
            {totalOpiniones > 0 ? (
              <Fragment>
                <div class="rating-summary"><b>{promedio}</b><span class="stars" role="img" aria-label={`Promedio ${promedio} de 5 estrellas`}>★★★★★</span><small>{totalOpiniones} {totalOpiniones === 1 ? 'opinión' : 'opiniones'}</small></div>
                {opiniones.map((o) => <article class="review-card"><div class="review-top"><b>{o.nombre}</b><span class="stars" role="img" aria-label={`${o.estrellas} de 5 estrellas`}>{estrellasTxt(o.estrellas)}</span></div><p>{o.texto}</p><small>{o.fecha}</small></article>)}
              </Fragment>
            ) : (
              <div class="review-empty"><div class="quote-mark">“</div><h3>Aún no hay opiniones publicadas</h3><p>Si ya reparaste tu equipo con nosotros, cuéntanos cómo te fue. Tu experiencia ayuda a otras personas de Urachiche a conocernos.</p></div>
            )}
            <a class="review-wa" href={wa('Hola, Conexiones MD. Quiero compartir mi opinión sobre el servicio recibido.')} target="_blank" rel="noopener noreferrer">También puedes escribirnos por WhatsApp <span>↗</span></a>
          </div>
          <form class="consult-form review-form" id="review-form" name="opiniones" method="POST" action="/" data-netlify="true" netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="opiniones" />
            <p class="hp" aria-hidden="true"><label>No llenar este campo<input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
            <h3>Deja tu opinión</h3>
            <label>Tu nombre<input name="nombre" maxlength="40" placeholder="Como quieres que aparezca" required /></label>
            <fieldset class="star-input"><legend>Tu calificación</legend>
              <div class="star-row">
                {[5, 4, 3, 2, 1].map((n) => <Fragment><input type="radio" id={`estrella-${n}`} name="estrellas" value={n} required /><label for={`estrella-${n}`} title={`${n} ${n === 1 ? 'estrella' : 'estrellas'}`}><span class="sr">{n} {n === 1 ? 'estrella' : 'estrellas'}</span>★</label></Fragment>)}
              </div>
            </fieldset>
            <label>Tu opinión<textarea name="opinion" rows="4" maxlength="400" placeholder="¿Cómo fue tu experiencia con nosotros?" required></textarea></label>
            <button class="button button-primary consult-submit" type="submit">Enviar opinión <span>↗</span></button>
            <small class="form-privacy">Revisamos cada opinión antes de publicarla.</small>
            <p class="form-status" id="review-status" role="status" aria-live="polite"></p>
          </form>
        </div>
      </section>

      <section class="contact-section" id="contacto"><div class="contact-content"><div class="eyebrow"><i></i> ESTAMOS PARA AYUDARTE</div><h2>¿Qué le pasa<br />a tu <em>celular?</em></h2><p>Escríbenos. Cuéntanos qué equipo tienes y qué problema presenta. Te atenderemos por WhatsApp.</p><a class="button button-primary button-light" href={wa()} target="_blank" rel="noopener noreferrer">Hablar por WhatsApp <span>↗</span></a></div><div class="contact-details"><div class="detail"><span>VISÍTANOS</span><b>Avenida principal, Urachiche</b><small>Yaracuy, Venezuela</small><a href="https://www.google.com/maps/search/?api=1&query=Avenida+Principal%2C+Urachiche%2C+Yaracuy%2C+Venezuela" target="_blank" rel="noopener noreferrer">Ver ubicación ↗</a></div><div class="detail"><span>CONTÁCTANOS</span><b>+58 412-0565259</b><small>Atención directa por WhatsApp</small><a href={wa()} target="_blank" rel="noopener noreferrer">Enviar mensaje ↗</a></div><div class="detail"><span>HORARIO DE ATENCIÓN</span><b>8:00 a. m. – 12:00 p. m.</b><small>3:00 p. m. – 7:00 p. m.</small><small>Atendemos en dos turnos</small></div></div></section>
    </main>

    <footer><a class="brand footer-brand" href="#inicio"><span class="brand-mark">C<span>M</span></span><span>CONEXIONES <b>MD</b><small>SERVICIO TÉCNICO</small></span></a><p>Reparaciones con compromiso. Urachiche, Yaracuy.</p><span class="copyright">© {new Date().getFullYear()} CONEXIONES MD</span></footer>
    <a class="whatsapp-float" href={wa()} target="_blank" rel="noopener noreferrer" aria-label="Contactar a Conexiones MD por WhatsApp"><span class="wa-icon">◔</span><span>¿Necesitas ayuda?</span><b>WhatsApp ↗</b></a>
  </body>
  <script>
    const repairForm = document.querySelector<HTMLFormElement>('#repair-form');
    repairForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!repairForm.reportValidity()) return;
      const data = new FormData(repairForm);
      const message = [
        'Hola, Conexiones MD. Quiero hacer una consulta online por una reparación.',
        `Nombre: ${data.get('nombre')}`,
        `WhatsApp de contacto: ${data.get('contacto')}`,
        `Equipo: ${data.get('equipo')}`,
        `Marca y modelo: ${data.get('modelo')}`,
        `Falla: ${data.get('falla')}`,
        `Detalles: ${data.get('detalle') || 'No agregados'}`
      ].join('\n');
      window.open(`https://wa.me/584120565259?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
      const status = document.querySelector<HTMLElement>('#form-status');
      if (status) status.textContent = 'Se abrió WhatsApp. Revisa los datos y pulsa Enviar para completar tu consulta.';
    });
  </script>

  <script>
    // Entrada progresiva de tarjetas y bloques al recorrer la página.
    const revealItems = document.querySelectorAll<HTMLElement>(
      '.service-card, .work-card, .benefit, .review-placeholder, .consult-form, .why-visual, .why-copy, .section-heading'
    );
    if ('IntersectionObserver' in window) {
      revealItems.forEach((item) => item.classList.add('motion-ready'));
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -35px 0px' });
      revealItems.forEach((item) => revealObserver.observe(item));
    }

    // Respuesta táctil breve al pulsar botones y enlaces de acción.
    document.querySelectorAll<HTMLElement>('.button, .service-card a, .header-cta, .whatsapp-float, .review-placeholder a').forEach((control) => {
      control.addEventListener('pointerdown', () => {
        control.classList.remove('tap-feedback');
        void control.offsetWidth;
        control.classList.add('tap-feedback');
        window.setTimeout(() => control.classList.remove('tap-feedback'), 420);
      });
    });
  </script>
</html>

<style is:global>
