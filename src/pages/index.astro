/* Identidad visual eléctrica: taller tecnológico, energía y reparación móvil */
:root{--ink:#f2f4f7;--black:#080b10;--orange:#ff7417;--orange2:#ff9a24;--paper:#0d121a;--muted:#a4adba;--line:#27313d;--electric:#20cfff}
body{background:#0b1017;color:#f2f4f7;background-image:radial-gradient(ellipse at 12% 20%,#ff741710,transparent 32%),radial-gradient(ellipse at 88% 54%,#20cfff0b,transparent 30%)}
.site-header{background:#070a0f;border-bottom:1px solid #26313c;box-shadow:0 8px 35px #0007}
.brand-mark{box-shadow:0 0 18px #ff741744,inset 0 0 12px #ff741722}
.hero{background:radial-gradient(ellipse at 75% 50%,#1b2935 0,#0b1119 42%,#070a0f 75%)}
.hero-grid{background-image:linear-gradient(#20cfff12 1px,transparent 1px),linear-gradient(90deg,#20cfff12 1px,transparent 1px)}
.hero:after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(115deg,transparent 45%,#ff74170c 46%,transparent 47%),repeating-linear-gradient(135deg,transparent 0 90px,#20cfff09 91px 92px,transparent 93px 170px);mask-image:linear-gradient(90deg,transparent,#000)}
.phone-front{box-shadow:0 0 0 1px #20cfff55,0 0 45px #ff741733,0 25px 65px #0009}
.screen-shape{background:radial-gradient(ellipse at 50% 30%,#ff9a24 0,#8e350e 24%,#101c28 70%)}
.ticker{background:linear-gradient(90deg,#ff7417,#ff9a24 55%,#ff7417);box-shadow:0 0 28px #ff741733}
.section{background:transparent;color:#f2f4f7}
.section-heading>p{color:#a4adba}.dark-eyebrow{color:#a4adba}
.services-grid{border-color:#27313d}.service-card{background:linear-gradient(145deg,#141d28,#0c121a);border-color:#27313d;position:relative;overflow:hidden}.service-card:before{content:"";position:absolute;left:0;top:0;width:2px;height:0;background:var(--orange);transition:.25s}.service-card:hover{background:#192432;box-shadow:0 14px 35px #0006}.service-card:hover:before{height:100%}.service-card h3{color:#f6f7f8}.service-card p{color:#a4adba}.service-icon{border-color:#ff741766;background:#ff741710;box-shadow:0 0 16px #ff74171a}
.gallery-section{padding:100px 9%;background:linear-gradient(180deg,#080c12,#101925 50%,#080c12);color:#f4f6f8;position:relative;overflow:hidden}.gallery-section:before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent 0 110px,#20cfff08 111px 112px,transparent 113px 220px);pointer-events:none}.gallery-section .section-heading,.gallery-grid{position:relative}.gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.work-card{margin:0;position:relative;min-height:300px;overflow:hidden;background:#101722;border:1px solid #2b3947;box-shadow:0 14px 30px #0005}.work-card-large{grid-row:span 1}.work-card img{width:100%;height:300px;object-fit:cover;display:block;filter:saturate(.88);transition:transform .4s,filter .4s}.work-card:hover img{transform:scale(1.045);filter:saturate(1.08)}.work-card figcaption{position:absolute;left:0;right:0;bottom:0;padding:34px 18px 17px;background:linear-gradient(transparent,#05080deF);display:grid;gap:5px}.work-card figcaption b{font:600 16px 'Space Grotesk';color:#fff}.work-card figcaption span{font-size:10px;color:#c2cbd5}
.consult-section{background:#111a25;color:#f4f6f8;border-top:1px solid #283746;border-bottom:1px solid #283746}.consult-heading>p,.consult-note{color:#b2bdc9}.consult-form{background:#0a1018;border:1px solid #344352;box-shadow:0 18px 45px #0005}.consult-form label{color:#dce4ec}.consult-form input,.consult-form select,.consult-form textarea{background:#111b26;border-color:#344352;color:#f4f6f8}.consult-form input::placeholder,.consult-form textarea::placeholder{color:#82909e}.consult-form input:focus,.consult-form select:focus,.consult-form textarea:focus{border-color:var(--electric);box-shadow:0 0 0 3px #20cfff15}.form-privacy{color:#9ba9b8}
.why-section{background:#070a0f;border-top:1px solid #26313c}.why-visual{background:radial-gradient(circle at 50% 50%,#1b3443,#111b27 48%,#090d13 78%);border:1px solid #283b49}.why-ring{border-color:#20cfff55;box-shadow:0 0 0 35px #20cfff0c,0 0 0 70px #ff74170b,0 0 35px #20cfff22}.why-symbol span{color:var(--electric)}.benefit{border-color:#28313d}.benefit>span{color:var(--electric)}
.reviews-section{background:#0d141d;color:#f4f6f8}.review-placeholder{background:#131e2a;border-color:#2a3948}.review-placeholder p{color:#aab6c2}.review-stars{color:var(--orange)}
