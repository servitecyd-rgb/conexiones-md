/* Animación tecnológica: destellos eléctricos, barrido y entrada al hacer scroll */
:root { --electric-cyan: #20cfff; --electric-orange: #ff7626; }
.service-card, .work-card, .review-placeholder, .consult-form, .benefit, .why-visual, .why-copy, .section-heading {
  transition: transform .38s cubic-bezier(.2,.75,.25,1), box-shadow .38s ease, border-color .38s ease, opacity .55s ease;
}
.service-card { position:relative; isolation:isolate; overflow:hidden; }
.service-card::before, .work-card::before {
  content:""; position:absolute; z-index:2; pointer-events:none; inset:-120% -45%;
  background:linear-gradient(110deg, transparent 43%, #20cfff16 48%, #20cfff72 50%, #ff762644 52%, transparent 58%);
  transform:translateX(-65%) rotate(8deg); transition:transform .85s ease;
}
.service-card::after { content:""; position:absolute; inset:0; border:1px solid transparent; pointer-events:none; transition:border-color .3s, box-shadow .3s; }
.service-card:hover, .service-card:focus-within { transform:translateY(-8px); border-color:#20cfff88; box-shadow:0 16px 42px #20cfff18, 0 0 24px #ff76261c; }
.service-card:hover::before, .service-card:focus-within::before, .work-card:hover::before { transform:translateX(65%) rotate(8deg); }
.service-card:hover::after, .service-card:focus-within::after { border-color:#20cfff66; box-shadow:inset 0 0 22px #20cfff12; }
.work-card { position:relative; isolation:isolate; overflow:hidden; }
.work-card img { transition:transform .65s cubic-bezier(.2,.75,.25,1), filter .45s ease; }
.work-card:hover img { transform:scale(1.055); filter:saturate(1.15) contrast(1.08); }
.work-card:hover { box-shadow:0 14px 38px #06121e30, 0 0 22px #20cfff22; }
.pulse-dot { animation:electric-pulse 1.8s ease-in-out infinite; }
@keyframes electric-pulse { 0%,100%{box-shadow:0 0 5px #ff7417,0 0 12px #ff7417; opacity:1} 50%{box-shadow:0 0 3px #20cfff,0 0 19px #20cfff; opacity:.72} }
.button, .service-card a, .header-cta, .whatsapp-float, .review-placeholder a { position:relative; overflow:hidden; transition:transform .22s ease, box-shadow .22s ease, filter .22s ease; }
.button::after, .service-card a::after, .header-cta::after, .whatsapp-float::after, .review-placeholder a::after {
  content:""; position:absolute; inset:0 auto 0 -65%; width:45%; transform:skewX(-22deg);
  background:linear-gradient(90deg,transparent,#ffffff65,transparent); transition:left .55s ease; pointer-events:none;
}
.button:hover::after, .service-card a:hover::after, .header-cta:hover::after, .whatsapp-float:hover::after, .review-placeholder a:hover::after { left:130%; }
.button:active, .service-card a:active, .header-cta:active, .whatsapp-float:active, .review-placeholder a:active, .tap-feedback { transform:scale(.965); filter:brightness(1.16); box-shadow:0 0 0 3px #20cfff38,0 0 24px #ff762655; }
.button-primary:hover { box-shadow:0 8px 28px #ff76264d,0 0 18px #20cfff22; }
.motion-ready { opacity:0; transform:translateY(24px); }
.motion-ready.is-visible { opacity:1; transform:translateY(0); }
.service-card.motion-ready:nth-child(3n+2), .work-card.motion-ready:nth-child(3n+2) { transition-delay:.08s; }
.service-card.motion-ready:nth-child(3n), .work-card.motion-ready:nth-child(3n) { transition-delay:.16s; }
@media (hover:none) { .service-card:hover, .work-card:hover { transform:none; } }
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior:auto !important; animation-duration:.01ms !important; animation-iteration-count:1 !important; transition-duration:.01ms !important; }
  .motion-ready { opacity:1; transform:none; }
}

</style>

<script>
  const reviewForm = document.querySelector<HTMLFormElement>('#review-form');
  reviewForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!reviewForm.reportValidity()) return;
    const status = document.querySelector<HTMLElement>('#review-status');
    const body = new URLSearchParams(new FormData(reviewForm) as any).toString();
    try {
      const res = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
      if (!res.ok) throw new Error('fallo');
      reviewForm.reset();
      if (status) status.textContent = '¡Gracias! Tu opinión fue enviada y se publicará después de revisarla.';
    } catch (e) {
      if (status) status.textContent = 'No se pudo enviar. Inténtalo otra vez o escríbenos por WhatsApp.';
    }
  });
</script>
