-items:center;gap:27px;margin-top:32px}.button{display:inline-flex;align-items:center;gap:32px;padding:17px 21px;font-size:12px;font-weight:700;transition:.2s}.button-primary{background:var(--orange);color:#111}.button-primary:hover{background:#ff9a5a;transform:translateY(-2px)}.button span{font-size:17px}.text-link{font-size:12px;color:#ddd}.text-link span{color:var(--orange);margin-left:8px}.hero-proof{display:flex;align-items:center;gap:12px;margin-top:57px}.proof-icon{width:28px;height:28px;border:1px solid #5a5a5a;border-radius:50%;display:grid;place-items:center;color:var(--orange)}.hero-proof b,.hero-proof small{display:block}.hero-proof b{font-size:11px}.hero-proof small{font-size:10px;color:#888;margin-top:4px}.hero-art{position:absolute;right:10%;top:50%;transform:translateY(-50%);width:410px;height:470px}.orange-glow{position:absolute;width:260px;height:260px;border-radius:50%;background:#ff7626;filter:blur(105px);opacity:.25;top:110px;left:80px}.orbit{position:absolute;border:1px solid #343434;border-radius:50%;transform:rotate(-28deg)}.orbit-one{width:400px;height:180px;top:140px;left:0}.orbit-two{width:350px;height:300px;top:85px;left:30px;transform:rotate(48deg)}.phone{position:absolute;border:5px solid #4b4d50;border-radius:35px;background:linear-gradient(140deg,#282b2f,#08090a);box-shadow:0 25px 65px #0009}.phone-back{width:190px;height:350px;left:58px;top:55px;transform:rotate(-13deg)}.phone-front{width:190px;height:365px;left:175px;top:80px;transform:rotate(10deg);border-color:#777;background:#111;overflow:hidden}.camera-row{display:flex;gap:9px;padding:20px}.camera-row i{width:34px;height:34px;border-radius:50%;background:radial-gradient(circle at 40% 40%,#456078,#10151d 60%);border:3px solid #666}.speaker{position:absolute;top:10px;left:75px;width:38px;height:7px;border-radius:8px;background:#333;z-index:2}.screen-shape{position:absolute;inset:0;background:radial-gradient(ellipse at 70% 35%,#ff8539 0,#a83c13 28%,#17110e 68%);display:flex;flex-di